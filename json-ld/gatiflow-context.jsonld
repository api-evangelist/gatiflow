{
  "@context": {
    "@version": 1.1,
    "AlertEvent": "gatiflow:Alert",
    "DailyInsights": "gatiflow:DailyInsights",
    "DeepDivePreview": "schema:Article",
    "EmergingAlert": "gatiflow:Alert",
    "ErrorResponse": "gatiflow:ErrorEnvelope",
    "IntelligenceReport": "gatiflow:Report",
    "NewHirerAlert": "gatiflow:Alert",
    "SignalItem": "gatiflow:Signal",
    "SnapshotSummary": "gatiflow:Snapshot",
