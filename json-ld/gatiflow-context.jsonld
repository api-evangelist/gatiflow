      "@id": "gatiflow:baseline",
      "@type": "xsd:decimal"
    },
    "category": {
      "@id": "gatiflow:category"
    },
    "change_pct": {
      "@id": "gatiflow:changePercent",
      "@type": "xsd:decimal"
    },
    "company": {
      "@id": "schema:hiringOrganization"
    },
    "confidence": {
      "@id": "gatiflow:confidence",
      "@type": "xsd:decimal"
    },
    "dcterms": "http://purl.org/dc/terms/",
    "detail": {
      "@id": "schema:description"
    },
    "evidence": {
      "@id": "gatiflow:evidence",
      "@type": "@json"
    },
    "gatiflow": "https://gatiflow.io/vocabulary.json#",
    "generated_at": {
      "@id": "schema:dateCreated",
      "@type": "xsd:dateTime"
    },
    "hiring_status": {
      "@id": "gatiflow:hiringStatus"
    },
    "narrative": {
      "@id": "gatiflow:narrative"
    },
    "plan": {
      "@id": "gatiflow:plan"
    },
    "preview": {
      "@id": "schema:abstract"
    },
    "published_at": {
      "@id": "schema:datePublished",
      "@type": "xsd:dateTime"
    },
    "relevance": {
      "@id": "gatiflow:relevance",
      "@type": "xsd:decimal"
    },
    "request_id": {
      "@id": "gatiflow:requestId"
    },
    "schema": "https://schema.org/",
    "snapshot_id": {
      "@id": "gatiflow:Snapshot"
    },
    "source": {
      "@id": "gatiflow:source"
    },
    "title": {
      "@id": "schema:name"
    },
    "topic": {
      "@id": "gatiflow:topic"
    },
    "url": {
      "@id": "schema:url",
      "@type": "@id"
    },
    "velocity": {
      "@id": "gatiflow:velocity",
      "@type": "@json"
    },
    "word_count": {
      "@id": "schema:wordCount",
      "@type": "xsd:integer"
    },
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "https://gatiflow.io/context.jsonld",
  "dcterms:description": "Maps the fields of GatiFlow API responses to the GatiFlow API Vocabulary and to schema.org. Use it as \"@context\": \"https://gatiflow.io/context.jsonld\" over a response from https://api.gatiflow.io.",
  "dcterms:hasVersion": "2.5.0",
  "dcterms:publisher": "GatiFlow",
  "dcterms:source": "https://gatiflow.io/openapi.json",
  "dcterms:title": "GatiFlow API JSON-LD context"
}
